{
  "name": "asset-management-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Root helper scripts for Codespaces/local workflow",
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev -- --host 0.0.0.0 --port 5173",
    "frontend:build": "npm --prefix frontend run build",
    "codespace:run": "bash scripts/codespace_run.sh",
    "codespace:backend": "bash scripts/codespace_run.sh --backend-only",
    "codespace:down": "bash scripts/codespace_run.sh --down",
    "codespace:logs": "bash scripts/codespace_run.sh --logs"
  }
}
